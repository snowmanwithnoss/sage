// Sage — Cloudflare Worker + static assets + D1
{
  "name": "sage",
  "compatibility_date": "2025-10-01",
  // Better Auth uses AsyncLocalStorage (node:async_hooks)
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public origin of the app. Local dev overrides this in .dev.vars.
    "BETTER_AUTH_URL": "https://sage.quiet-flower-951f.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sage",
      "database_id": "0347f4c1-dc6d-48c3-ae59-8606bbd06066",
      "migrations_dir": "migrations"
    }
  ]
}

// Sage — Cloudflare Worker + static assets + D1
{
  "name": "herbs",
  "compatibility_date": "2025-10-01",
  // Better Auth uses AsyncLocalStorage (node:async_hooks)
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public origin of the app. Local dev overrides this in .dev.vars.
    "BETTER_AUTH_URL": "https://herbs.aroundme.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sage",
      "database_id": "35bac70f-d1c7-4539-b271-06c02a4e82ff",
      "migrations_dir": "migrations"
    }
  ],
  // Spot photos (full + thumb per photo). Free plan: 1 GB, 1,000 writes/day.
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "f6120817ba914b72ad2dad6ff43400d0"
    }
  ]
}
